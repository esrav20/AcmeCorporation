@model IEnumerable<AcmeCorporation.Core.Data.DrawSubmission>

@{
    ViewData["Title"] = "All Submissions";
}

<h2 class="mt-4">Submissions</h2>
<hr />

<table class="table table-striped table-hover">
    <thead class="table-dark">
    <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Date of Birth</th>
        <th>Serial Number</th>
        <th>Submitted</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var s in Model)
    {
        <tr>
            <td>@s.FirstName @s.LastName</td>
            <td>@s.Email</td>
            <td>@s.DateOfBirth.ToString("yyyy-MM-dd")</td>
            <td class="font-monospace">@s.SerialNumber.Number</td>
            <td>@s.SubmittedAt.ToString("g")</td>
        </tr>
    }
    </tbody>
</table>

<nav>
    <ul class="pagination justify-content-center">
        @for (var i = 1; i <= ViewBag.TotalPages; i++)
        {
            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
            </li>
        }
    </ul>
</nav>