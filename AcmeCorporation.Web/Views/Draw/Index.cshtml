@model AcmeCorporation.Web.Models.SubmissionViewModel

@{
    ViewData["Title"] = "Prize Draw Entry";
}

<div class="row justify-content-center mt-5 mb-5">
    <div class="col-md-6">
        <div class="acme-card">
            <h2 class="mb-1">Enter the Prize Draw</h2>
            <p class="text-muted mb-4">Fill in your details and product serial number</p>
            <hr/>

            <div id="ajax-alert" class="alert d-none"></div>
            <form id="draw-form" asp-action="Index" method="post">
                <div class="mb-3">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control"/>
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control"/>
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" type="email"/>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SerialNumber" class="form-label"></label>
                    <input asp-for="SerialNumber" class="form-control font-monospace" placeholder="ACME-XXXX-XXXX-XXXX"/>
                    <span asp-validation-for="SerialNumber" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DateOfBirth" class="form-label"></label>
                    <input asp-for="DateOfBirth" class="form-control" type="date"/>
                    <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                </div>
                <button type="submit" id="submit-btn" class="btn btn-primary w-100">Submit Entry</button>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('draw-form').addEventListener('submit', async function(e) {
            e.preventDefault();

            const form = e.target;

            const button = document.getElementById('submit-btn');
            const alert = document.getElementById('ajax-alert');

            if (typeof $ !== 'undefined' && !$(form).valid()) return;

            button.disabled = true;
            button.textContent = 'Submitting...';
            alert.classList.add('d-none');

            const payload = {
                firstName: document.querySelector('[name="FirstName"]').value,
                lastName: document.querySelector('[name="LastName"]').value,
                email: document.querySelector('[name="Email"]').value,
                serialNumber: document.querySelector('[name="SerialNumber"]').value,
                dateOfBirth: document.querySelector('[name="DateOfBirth"]').value,
            };

            try {
                const token = document.querySelector('[name="__RequestVerificationToken"]').value;
                const response = await fetch('/api/draw', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(payload)
                });
                const data = await response.json();

                if (response.ok && data.success){
                    alert.className = 'alert alert-success';
                    alert.textContent = 'Your entry has been submitted successfully!';
                    form.reset();
                } else {
                    alert.className = 'alert alert-danger';
                    alert.textContent = 'Something went wrong!';

                }
            } catch {
                alert.className = 'alert alert-danger';
                alert.textContent = 'Something went wrong.';
            }
            alert.classList.remove('d-none');
            button.disabled = false;
            button.textContent = 'Submit Entry';

        });

    </script>
}