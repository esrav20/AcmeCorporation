@model AcmeCorporation.Web.Models.SubmissionViewModel

@{
    ViewData["Title"] = "Prize Draw Entry";
}

<div class = "row justify-content-center mt-4">
    <div class="col-md-6">
        <h2>Enter the ACME CORPORATION Prize Draw</h2>
        <hr />
        
        <div id="ajax-alert" class="alert d-none" ></div>
        <form id="draw-form" asp-action="Index" method="post">
            <div class="mb-3">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LastName" class="form-label"></label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" type="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SerialNumber" class="form-label"></label>
                <input asp-for="SerialNumber" class="form-control font-monospace" placeholder="ACME-XXXX-XXXX-XXXX" />
                <span asp-validation-for="SerialNumber" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DateOfBirth" class="form-label"></label>
                <input asp-for="DateOfBirth" class="form-control" type="date" />
                <span asp-validation-for="DateOfBirth" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="use-ajax" />
                <label class="form-check-label" for="use-ajax">Submit via API (AJAX)</label>
            </div>

            <button type="submit" id="submit-btn" class="btn btn-primary w-100">Submit Entry</button>
        </form>
        

    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('submit-btn').addEventListener('submit', async function(e) {
            if (!document.getElementById('use-ajax').checked) return;
            e.preventDefault();
            const button = document.getElementById('submit-btn');
            const alert = document.getElementById('ajax-alert');
            button.disabled = true;
            button.textContent = 'Submitting...';

            const payload = {
                firstName: document.querySelector('[name="FirstName"]').value,
                lastName: document.querySelector('[name="LastName"]').value,
                email: document.querySelector('[name="Email"]').value,
                serialNumber: document.querySelector('[name="SerialNumber"]').value,
                dateOfBirth: document.querySelector('[name="DateOfBirth"]').value,
            };

            try {
                const token = document.querySelector('[name="__RequestVerificationToken"]').value;
                const response = await fetch('/api/draw', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json', 'RequestVerificationToken': token},
                    body: JSON.stringify(payload)
                });
                const data = await response.json();

                alert.className = response.ok && data.success
                    ? 'alert alert-success'
                    : 'alert alert-danger';
                alert.textContent = response.ok && data.success
                    ? 'Successfully sent!'
                    : (data.errorMessage || 'Something went wrong.');
            } catch {
                alert.className = 'alert alert-danger';
                alert.textContent = 'Something went wrong.';
            }
            alert.classList.remove('d-none');
            button.disabled = false;
            button.textContent = 'Submit Entry';

        });
        
    </script>
}
