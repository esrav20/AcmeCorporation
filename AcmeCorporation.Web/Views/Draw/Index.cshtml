@model AcmeCorporation.Web.Models.SubmissionViewModel

@{
    ViewData["Title"] = "Prize Draw";
}

<div class="row justify-content-center mt-5 mb-5">
    <div class="col-md-6">
        <div class="acme-card">
            <h2 class="mb-1">Enter the Prize Draw</h2>
            <p class="text-muted mb-4">Fill in your details and product serial number</p>
            <hr/>

            <div id="ajax-alert" class="alert d-none" role ="alert"></div>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <form id="draw-form" asp-action="Index" method="post">
                @Html.AntiForgeryToken()
                
                <div class="mb-3">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control"/>
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control"/>
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" type="email"/>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SerialNumber" class="form-label"></label>
                    <input asp-for="SerialNumber" class="form-control font-monospace" placeholder="ACME-XXXX-XXXX-XXXX"/>
                    <span asp-validation-for="SerialNumber" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DateOfBirth" class="form-label"></label>
                    <input asp-for="DateOfBirth" class="form-control" type="date"/>
                    <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                </div>
                <button type="submit" id="submit-btn" class="btn btn-primary w-100">Submit Entry</button>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src ="js/draw-form.js"></script>
}